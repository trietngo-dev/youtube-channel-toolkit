{
  "language": "vi",
  "agents": {
    "plan": {
      "enabled": true
    },
    "code": {
      "enabled": true
    },
    "review": {
      "enabled": true
    },
    "test": {
      "enabled": true
    },
    "doc": {
      "enabled": true
    },
